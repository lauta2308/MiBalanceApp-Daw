# BEGIN DAW — pipeline runtime, NOT committed (managed by DAW)
#   .daw-state.json  = which phase you are in; yours, not the repo's
#   .daw-paused/     = paused tickets
#   .daw-sessions/   = live session markers
#   .daw-journal.jsonl = transitions that landed; outlives the state file
.daw-state.json
.daw-paused/
.daw-sessions/
.daw-journal.jsonl
# END DAW

# Dependencias, compilación y resultados de pruebas
node_modules/
dist/
test-results/
playwright-report/
# Sesiones guardadas de las pruebas en navegador (tienen tokens)
pruebas-navegador/.sesiones/
__pycache__/

# Variables de entorno locales (nunca se commitean)
.env
.env*.local

# Archivos temporales de la CLI de Supabase (supabase link)
supabase/.temp/
