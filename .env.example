# Copie este archivo como .env.local y complete los valores de su proyecto de Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La clave de service role NUNCA va en .env.local ni lleva el prefijo VITE_.
# Va solo en .env.pruebas.local, que usan las pruebas de pruebas/ y pruebas-navegador/:
# SUPABASE_SERVICE_ROLE_KEY=
#
# Contraseña de la base de datos del proyecto, también solo en .env.pruebas.local. Las pruebas de
# pruebas/ la usan para conectarse directo a PostgreSQL (con TLS verificado contra
# supabase/certificados/prod-ca-2021.crt):
# SUPABASE_DB_PASSWORD=
#
# Las pruebas de pruebas/ requieren haber vinculado el proyecto con
#   npx supabase link --project-ref <ref>
# porque leen la dirección del pooler de supabase/.temp/pooler-url.
